# ───────── Base de datos (Neon) ─────────
# Pooled (con -pooler en el host): la usa la app
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/amora?sslmode=require"
# Directa (sin -pooler): la usan las migraciones
DIRECT_URL="postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/amora?sslmode=require"

# ───────── Auth.js ─────────
# Generar con: openssl rand -base64 32
AUTH_SECRET="cambiame-por-un-secreto-largo"
# En producción poné la URL pública (https://tu-dominio.com). En local no hace falta.
# AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ───────── Primer usuario admin (lo usa el seed y npm run admin:create) ─────────
ADMIN_EMAIL="admin@amora.com"
ADMIN_PASSWORD="cambiame123"
ADMIN_NAME="Dueña AMORA"

# ───────── Fotos (Cloudinary) ─────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="amora/productos"

# ───────── Mails (Resend). Si está vacío, los mails se imprimen en la consola ─────────
RESEND_API_KEY=""
EMAIL_FROM="AMORA <no-reply@tu-dominio.com>"

# ───────── Mercado Pago (Checkout Pro) ─────────
# Credenciales de producción o de prueba desde https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN=""
# Clave secreta del webhook (Tus integraciones → Webhooks → Configurar → Clave secreta)
MP_WEBHOOK_SECRET=""

# ───────── Datos del negocio ─────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="5491112345678"
SELLER_EMAIL="ventas@amora.com"
# Link al perfil de Instagram (página de contacto y pie de página)
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/amora"
# Mail público de la página de contacto (vacío = usa SELLER_EMAIL)
CONTACT_EMAIL=""

# ───────── Envío para pedidos pagados con Mercado Pago ─────────
# Costo fijo de envío (en pesos). Vacío o 0 = "a coordinar" después del pago.
SHIPPING_FLAT_RATE=""
# Envío gratis a partir de este monto (vacío = nunca)
FREE_SHIPPING_FROM=""
